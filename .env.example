# Backend
DATABASE_URL=postgresql+psycopg://ctf:ctf_password@localhost:5432/ctf_platform
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
SECRET_KEY=replace-with-a-long-random-secret

# Frontend
VITE_API_URL=http://127.0.0.1:8000


# Authentication
FRONTEND_URL=http://127.0.0.1:5173
REQUIRE_EMAIL_VERIFICATION=true
DEV_AUTH_LINKS=false

# SMTP (required to actually deliver verification/reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Private S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO)
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SIGNED_URL_TTL=600
PUBLIC_API_URL=http://127.0.0.1:8000

# Production operations
ENVIRONMENT=development
METRICS_TOKEN=replace-with-a-random-monitoring-token
LIVE_RUNTIME_ENABLED=false
